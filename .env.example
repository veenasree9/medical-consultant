# Server & CORS
PORT=3000
FRONTEND_ORIGIN=*
JWT_SECRET=

# Google Cloud SQL (PostgreSQL) Runtime Variables
SQL_HOST=/cloudsql/project:region:instance
SQL_DB_NAME=cloud_sql_development_database
SQL_USER=ai_studio_app_user
SQL_PASSWORD=
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=

# Alternative External PostgreSQL Connection URL
DATABASE_URL=postgresql://user:password@localhost:5432/medicare

# Doctor & Patient Default Passwords (stored as bcrypt hashes in PostgreSQL)
DOCTOR_PASSWORD=1234
PATIENT_DEMO_PASSWORD=1234

# Twilio SMS OTP (Optional; demo OTP 123456 used if unconfigured)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Face Identification Service (Optional; must be configured for real biometric face matching)
# Option A: AWS Rekognition
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_REKOGNITION_COLLECTION_ID=

# Option B: Azure Face API
AZURE_FACE_API_KEY=
AZURE_FACE_ENDPOINT=
